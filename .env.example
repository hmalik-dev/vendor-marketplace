# ---------------------------------------------------------------------------
# VendorHub environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NODE_ENV=development
# Public origin of the Next.js frontend.
WEB_URL=http://localhost:3000
# Fastify API origin, used server-side by apps/web.
API_URL=http://localhost:4000
# Fastify API origin, used in the browser by apps/web.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Port and interface the Fastify API listens on.
PORT=4000
HOST=0.0.0.0
# Pino level for the API: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Requests per minute, per IP, before the API replies 429.
RATE_LIMIT_MAX=120

# --- Database (PostgreSQL 16) ----------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=postgresql://vendorhub:vendorhub_dev@localhost:5432/vendorhub

# --- Auth (Clerk) — wired up in ticket #2 ----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signing secret for POST /webhooks/clerk (svix).
CLERK_WEBHOOK_SECRET=whsec_...
# Hosted auth routes rendered by apps/web.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Payments (Stripe Connect) — wired up in tickets #9/#10 ----------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for POST /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission as a decimal fraction (0.12 = 12%).
STRIPE_PLATFORM_FEE_RATE=0.12

# --- Storage (Cloudflare R2, S3-compatible) — wired up in ticket #3 --------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=vendorhub
# Public base URL for uploaded objects (R2 public bucket or custom domain).
S3_PUBLIC_URL=https://cdn.vendorhub.com

# --- Email (Resend) — wired up in ticket #11 -------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@vendorhub.com

# --- Error tracking (Sentry) — wired up in ticket #15 ----------------------
SENTRY_DSN=https://...@sentry.io/...
