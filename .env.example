# ---------------------------------------------------------------------------
# Vendor Marketplace environment variables.
#
# GENERATED FROM packages/shared/src/env/registry.ts — DO NOT EDIT BY HAND.
# Add or change a variable there, then run `pnpm env:example`.
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# The end-to-end test account lives in `.env.e2e.local`, not here.
# ---------------------------------------------------------------------------

# --- App + Database --------------------------------------------------------
# Runtime mode for every Node process in the workspace.
NODE_ENV=development
# Public origin of the Next.js frontend; also the API CORS allow-list.
WEB_URL=http://localhost:3000
# Fastify API origin, used server-side by apps/web.
API_URL=http://localhost:4000
# Set to 1 to send Content-Security-Policy instead of Content-Security-Policy-Report-Only from a non-production apps/web. Production always enforces. Read at build time by next.config.ts; a browser pass under report-only cannot fail on a blocked origin, so any pass over checkout, sign-in or upload runs with this on.
CSP_ENFORCE=0
# Fastify API origin, used in the browser by apps/web.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Port the Fastify API listens on.
PORT=4000
# Port the Next.js dev server binds. Exported by `pnpm lane:up` into the lane environment; setting it in this file has no effect, because the dev script reads it from the shell before Next loads .env.
WEB_PORT=3000
# Interface the Fastify API binds to.
HOST=0.0.0.0
# Pino level for the API.
LOG_LEVEL=info
# Requests per minute, per IP, before the API replies 429.
RATE_LIMIT_MAX=120
# Postgres for this environment — the local Docker service in development, a pooled Neon branch in staging and production.
DATABASE_URL=postgresql://...
# Direct unpooled connection for migrations, drizzle-kit and pg_dump. Neon only; leave unset locally, where there is no PgBouncer to bypass.
DATABASE_URL_UNPOOLED=postgresql://...
# Neon branch the connection strings point at, when they point at Neon at all. Unset for local Docker development; never `production`.
NEON_BRANCH=<your-neon-branch>

# --- Auth (Clerk) ----------------------------------------------------------
# The Neon Auth endpoint of the branch this deployment's users live on; the API verifies session tokens against its JWKS and the web proxies sign-in to it.
NEON_AUTH_BASE_URL=<neon-auth-base-url>
# Signs the cached Neon Auth session cookie of the web app.
NEON_AUTH_COOKIE_SECRET=<openssl rand -base64 32>
# Clerk secret key used by the API to verify session tokens.
CLERK_SECRET_KEY=sk_test_...
# svix signing secret for POST /webhooks/clerk.
CLERK_WEBHOOK_SECRET=whsec_...
# The Svix endpoint configured on the Clerk app. Checked at startup against this deployment, because a webhook pointed elsewhere fails silently.
CLERK_WEBHOOK_ENDPOINT=http://localhost:4000/webhooks/clerk

# --- Object storage (Cloudflare R2 / MinIO) --------------------------------
# S3 API endpoint — the MinIO compose service locally, R2 in production.
S3_ENDPOINT=http://localhost:9000
# S3 access key id.
S3_ACCESS_KEY_ID=vendor-marketplace
# S3 secret access key.
S3_SECRET_ACCESS_KEY=vendor_marketplace_dev
# Bucket uploads are written to.
S3_BUCKET=vendor-marketplace-uploads
# Public base URL uploaded objects are served from, with no trailing slash.
S3_PUBLIC_URL=http://localhost:9000/vendor-marketplace-uploads
# Public base URL for images, mirroring S3_PUBLIC_URL for the browser.
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/vendor-marketplace-uploads
# R2 and MinIO both address buckets by path rather than by subdomain.
S3_FORCE_PATH_STYLE=true

# --- Payments (Stripe Connect) ---------------------------------------------
# Stripe secret key used by the API for Connect and PaymentIntents.
STRIPE_SECRET_KEY=sk_test_...
# Stripe publishable key, read by the browser bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for POST /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission as a decimal fraction (0.12 = 12%).
STRIPE_PLATFORM_FEE_RATE=0.12

# --- Email (Resend) --------------------------------------------------------
# Resend API key for transactional email.
RESEND_API_KEY=re_...
# svix signing secret for POST /webhooks/resend. Optional: without it delivery events are refused and only send attempts are recorded.
RESEND_WEBHOOK_SECRET=whsec_...
# From address on every transactional email. Free-form; no shape is enforced.
EMAIL_FROM=noreply@orla.com
# Where the /support form sends. A deployment must state the monitored address.
SUPPORT_EMAIL_TO=support@orla.com
# Where operator alerts (disputes, failed payouts and refunds) and the daily digest are sent. Required on a deployment; development logs alerts instead.
OPERATOR_ALERT_EMAIL=operator@...
# IANA time zone of the operator; the daily digest is sent at 07:00 there.
OPERATOR_TIMEZONE=America/New_York

# --- Error tracking (Sentry) -----------------------------------------------
# Sentry DSN the API reports errors to. Unset locally; required on a deployment.
SENTRY_DSN=https://...@sentry.io/...
# Sentry DSN the web app reports errors to, from the server and the browser. Unset locally; required on a deployment.
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Sentry organization token the production web build uploads source maps with.
SENTRY_AUTH_TOKEN=sntrys_...
# Slug of the Sentry project the web source maps are uploaded to.
SENTRY_WEB_PROJECT=...
