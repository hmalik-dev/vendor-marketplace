# ---------------------------------------------------------------------------
# Vendor Marketplace environment variables.
#
# GENERATED FROM packages/shared/src/env/registry.ts — DO NOT EDIT BY HAND.
# Add or change a variable there, then run `pnpm env:example`.
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# The end-to-end test account lives in `.env.e2e.local`, not here.
# ---------------------------------------------------------------------------

# --- App + Database --------------------------------------------------------
# Runtime mode for every Node process in the workspace.
NODE_ENV=development
# Public origin of the Next.js frontend; also the API CORS allow-list.
WEB_URL=http://localhost:3000
# Fastify API origin, used server-side by apps/web.
API_URL=http://localhost:4000
# Fastify API origin, used in the browser by apps/web.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Port the Fastify API listens on.
PORT=4000
# Interface the Fastify API binds to.
HOST=0.0.0.0
# Pino level for the API.
LOG_LEVEL=info
# Requests per minute, per IP, before the API replies 429.
RATE_LIMIT_MAX=120
# Pooled Neon connection (PgBouncer) — application query traffic.
DATABASE_URL=postgresql://...
# Direct Neon connection — migrations, drizzle-kit, pg_dump.
DATABASE_URL_UNPOOLED=postgresql://...
# Neon branch the connection strings point at. Local development must never be `production`.
NEON_BRANCH=<your-neon-branch>

# --- Auth (Clerk) ----------------------------------------------------------
# Clerk publishable key, read by the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk secret key used by the API to verify session tokens.
CLERK_SECRET_KEY=sk_test_...
# svix signing secret for POST /webhooks/clerk.
CLERK_WEBHOOK_SECRET=whsec_...
# Route rendering the hosted sign-in component.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Route rendering the hosted sign-up component.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where sign-in lands when no redirect was requested.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-sign-in
# Where sign-up lands when no redirect was requested.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-sign-in

# --- Object storage (Cloudflare R2 / MinIO) --------------------------------
# S3 API endpoint — the MinIO compose service locally, R2 in production.
S3_ENDPOINT=http://localhost:9000
# S3 access key id.
S3_ACCESS_KEY_ID=vendor-marketplace
# S3 secret access key.
S3_SECRET_ACCESS_KEY=vendor_marketplace_dev
# Bucket uploads are written to.
S3_BUCKET=vendor-marketplace-uploads
# Public base URL uploaded objects are served from, with no trailing slash.
S3_PUBLIC_URL=http://localhost:9000/vendor-marketplace-uploads
# R2 and MinIO both address buckets by path rather than by subdomain.
S3_FORCE_PATH_STYLE=true

# --- Payments (Stripe Connect) ---------------------------------------------
# Stripe secret key used by the API for Connect and PaymentIntents.
STRIPE_SECRET_KEY=sk_test_...
# Stripe publishable key, read by the browser bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for POST /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission as a decimal fraction (0.12 = 12%).
STRIPE_PLATFORM_FEE_RATE=0.12

# --- Email (Resend) --------------------------------------------------------
# Resend API key for transactional email.
RESEND_API_KEY=re_...
# From address on every transactional email. Free-form; no shape is enforced.
EMAIL_FROM=noreply@venmatch.com

# --- Error tracking (Sentry) -----------------------------------------------
# Sentry DSN the API reports errors to.
SENTRY_DSN=https://...@sentry.io/...
