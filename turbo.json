{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "CSP_ENFORCE",
    "DEPLOYMENT_PLATFORM",
    "DEPLOYMENT_ORIGIN",
    "VERCEL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "RENDER",
    "RENDER_EXTERNAL_URL",
    "RAILWAY_PUBLIC_DOMAIN",
    "RAILWAY_ENVIRONMENT",
    "SENTRY_RELEASE",
    "RAILWAY_GIT_COMMIT_SHA",
    "VERCEL_GIT_COMMIT_SHA",
    "RENDER_GIT_COMMIT"
  ],
  "globalPassThroughEnv": [
    "API_URL",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "EMAIL_FROM",
    "HOST",
    "LOG_LEVEL",
    "NEON_AUTH_BASE_URL",
    "NEON_AUTH_COOKIE_SECRET",
    "NEON_AUTH_DATABASE_URL",
    "NEON_BRANCH",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_STORAGE_PUBLIC_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "OPERATOR_ALERT_EMAIL",
    "OPERATOR_TIMEZONE",
    "PORT",
    "RATE_LIMIT_MAX",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_DSN",
    "SENTRY_WEB_PROJECT",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET",
    "STORAGE_ENDPOINT",
    "STORAGE_FORCE_PATH_STYLE",
    "STORAGE_PUBLIC_URL",
    "STORAGE_REGION",
    "STORAGE_SECRET_ACCESS_KEY",
    "STRIPE_CONNECT_WEBHOOK_SECRET",
    "STRIPE_PLATFORM_FEE_RATE",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SUPPORT_EMAIL_TO",
    "WEB_PORT",
    "WEB_TIER_KEY",
    "WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:contention": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
