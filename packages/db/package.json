{
  "name": "@vendor-marketplace/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing/test-db.d.ts",
      "default": "./dist/testing/test-db.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:marketing": "tsx src/scripts/seed-marketing.ts",
    "studio": "drizzle-kit studio",
    "keys:from-urls": "tsx src/scripts/keys-from-urls.ts"
  },
  "dependencies": {
    "@vendor-marketplace/shared": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@types/node": "24.13.3",
    "@vendor-marketplace/config": "workspace:*",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
