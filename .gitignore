# Dependencies
node_modules/

# Build output
dist/

# Environment variables
# Ignore every .env variant, then re-admit the generated example. The
# previous rules listed `.env.local` and `.env.*.local` only, so an ad-hoc
# `.env.bak` or `.env.save` was stageable — a real secret one `git add -A`
# away from history.
.env
.env.*
!.env.example

# Turborepo
.turbo/

# Next.js
.next/
# `next dev` writes here instead, so a build cannot corrupt a live dev server.
.next-dev/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store

# IDE
.idea/
.vscode/

# Test coverage
coverage/

# Playwright MCP scratch output
.playwright-mcp/
# Browser-verification screenshots. They belong in the scratchpad, never in the
# tree — four of them were committed by a careless `git add -A` in #30 and cost
# 1.7MB. The repo has no legitimate PNG at its root, so this cannot hide one.
/*.png

# Parity measurement dumps — the element geometry a parity sweep reads out of a
# frame, written to the root as `f01.json`, `f02.json` and so on. Same class of
# scratch artifact as the screenshots above. Deliberately not `/*.json`, which
# would swallow package.json and tsconfig.json.
/f[0-9][0-9].json

# Tool-managed skill packs installed into the repo (see skills-lock.json).
# Note `.claude/skills/*`, not `.claude/skills/`: git does not descend into an
# ignored directory, so a directory rule would make the negations below
# unreachable and our own project skills could never be committed.
.claude/skills/*
!.claude/skills/run-*/
!.claude/skills/verify/
.agents/skills/
skills-lock.json

# Worktrees Claude Code creates for parallel lanes and isolated subagents.
# Their contents are a second checkout of this repo; they must never appear as
# untracked files in the main tree.
.claude/worktrees/

# Session-local scheduler state, not configuration.
.claude/scheduled_tasks.lock

# Approved Bash commands are stored here verbatim, so this file is exactly where
# a pasted credential ends up — and this repo is public. It was protected only by
# `~/.config/git/ignore` on one machine, which no clone carries; a second machine
# would have had nothing stopping `git add -A` from publishing it.
.claude/settings.local.json

# Local design scratch, not a build input
/vendor-marketplace-header.png

# Local state written by the Neon CLI/integration
.neon

# Film assets: licensed audio/video sources and renders. These are tens of MB
# of binaries that git cannot diff, and the tracks are redownloadable from the
# artist's library. The licence receipt is the exception and stays tracked —
# it is the record of our right to use the music, and it is 4KB of text.
# Note `/uploads/*`, not `/uploads/`: git does not descend into an ignored
# directory, so a directory rule would make the negation below unreachable.
/uploads/*
!/uploads/soundtrack-license.md
